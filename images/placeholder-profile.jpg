<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="200" height="200">
  <!-- Background -->
  <rect width="200" height="200" fill="#008080"/>
  
  <!-- Head -->
  <circle cx="100" cy="70" r="35" fill="#e0f2f1"/>
  
  <!-- Body -->
  <ellipse cx="100" cy="130" rx="40" ry="50" fill="#e0f2f1"/>
  
  <!-- Smile -->
  <path d="M 85 80 Q 100 90 115 80" stroke="#008080" stroke-width="2" fill="none" stroke-linecap="round"/>
  
  <!-- Eyes suggestion -->
  <circle cx="90" cy="65" r="2" fill="#008080"/>
  <circle cx="110" cy="65" r="2" fill="#008080"/>
  
  <!-- Text -->
  <text x="100" y="170" font-family="Arial, sans-serif" font-size="16" font-weight="bold" text-anchor="middle" fill="#ffffff">
    Profile Photo
  </text>
</svg>
